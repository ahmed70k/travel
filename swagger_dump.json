  "customOptions": {
    "tagsSorter": (a, b) => {
        const tagOrder = [
          "Auth",
          "Dashboards - Admin",
          "Dashboards - B2B",
          "Dashboards - B2C",
          "Dashboards - Me",
          "Bookings - Flights",
          "Bookings - Hotels",
          "Bookings - Cars",
          "Bookings - Lifecycle",
          "Bookings - My",
          "Users",
          "Availability",
          "Admin - Activity Logs",
          "Admin - B2B Config",
          "Admin - B2C Config",
        ];
        const ai = tagOrder.indexOf(a);
        const bi = tagOrder.indexOf(b);
        const aIndex = ai === -1 ? Number.MAX_SAFE_INTEGER : ai;
        const bIndex = bi === -1 ? Number.MAX_SAFE_INTEGER : bi;
        return aIndex - bIndex;
      },
    "operationsSorter": (a, b) => {
        const pathOrder = [
          "/api/auth/login",
          "/api/auth/me",
          "/api/auth/logout",
          "/api/dashboard/admin/overview",
          "/api/dashboard/admin/flights",
          "/api/dashboard/admin/hotels",
          "/api/dashboard/admin/cars",
          "/api/dashboard/admin/users",
          "/api/dashboard/admin/b2b",
          "/api/dashboard/admin/b2c",
          "/api/dashboard/b2b/overview",
          "/api/dashboard/b2c/overview",
          "/api/dashboard/me",
          "/api/bookings/flights",
          "/api/bookings/hotels",
          "/api/bookings/cars",
          "/api/bookings/{type}/{id}/confirm",
          "/api/bookings/{type}/{id}/cancel",
          "/api/bookings/{type}/{id}/refund",
          "/api/bookings/my",
          "/api/bookings/my/{type}/{id}",
          "/api/users",
          "/api/users/{id}",
          "/api/users/{id}/status",
          "/api/availability/flights",
          "/api/availability/hotels",
          "/api/availability/cars",
          "/api/admin/activity-logs",
          "/api/admin/b2b/distribution",
          "/api/admin/b2b/distribution/{id}",
          "/api/admin/b2b/top-agencies",
          "/api/admin/b2b/top-agencies/{id}",
          "/api/admin/b2c/distribution",
          "/api/admin/b2c/distribution/{id}",
          "/api/admin/b2c/growth",
          "/api/admin/b2c/growth/{id}",
        ];
        const methodOrder = { get: 1, post: 2, put: 3, patch: 4, delete: 5 };
        const aPath = a.get("path");
        const bPath = b.get("path");
        const aMethod = a.get("method");
        const bMethod = b.get("method");

        const ai = pathOrder.indexOf(aPath);
        const bi = pathOrder.indexOf(bPath);
        const aPathIndex = ai === -1 ? Number.MAX_SAFE_INTEGER : ai;
        const bPathIndex = bi === -1 ? Number.MAX_SAFE_INTEGER : bi;

        if (aPathIndex !== bPathIndex) {
          return aPathIndex - bPathIndex;
        }

        const aMethodIndex = methodOrder[aMethod] || 999;
        const bMethodIndex = methodOrder[bMethod] || 999;
        return aMethodIndex - bMethodIndex;
      },
    "docExpansion": "list"
  }
};
  url = options.swaggerUrl || url
  var urls = options.swaggerUrls
  var customOptions = options.customOptions
  var spec1 = options.swaggerDoc
  var swaggerOptions = {
    spec: spec1,
    url: url,
    urls: urls,
    dom_id: '#swagger-ui',
    deepLinking: true,
    presets: [
      SwaggerUIBundle.presets.apis,
      SwaggerUIStandalonePreset
    ],
    plugins: [
      SwaggerUIBundle.plugins.DownloadUrl
    ],
    layout: "StandaloneLayout"
  }
  for (var attrname in customOptions) {
    swaggerOptions[attrname] = customOptions[attrname];
  }
  var ui = SwaggerUIBundle(swaggerOptions)

  if (customOptions.oauth) {
    ui.initOAuth(customOptions.oauth)
  }

  if (customOptions.preauthorizeApiKey) {
    const key = customOptions.preauthorizeApiKey.authDefinitionKey;
    const value = customOptions.preauthorizeApiKey.apiKeyValue;
    if (!!key && !!value) {
      const pid = setInterval(() => {
        const authorized = ui.preauthorizeApiKey(key, value);
        if(!!authorized) clearInterval(pid);
      }, 500)

    }
  }

  if (customOptions.authAction) {
    ui.authActions.authorize(customOptions.authAction)
  }

  window.ui = ui
}
